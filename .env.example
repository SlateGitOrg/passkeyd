# passkeyd serve reads these when the matching flag is not given.
PASSKEYD_ADDR=localhost:8080
PASSKEYD_RP_ID=localhost
PASSKEYD_RP_NAME=passkeyd
# Comma-separated exact origins (scheme://host[:port]); https required except for localhost.
PASSKEYD_ORIGINS=http://localhost:8080
PASSKEYD_DB=passkeyd.db
# required | preferred | discouraged
PASSKEYD_UV=preferred
# none | indirect | direct
PASSKEYD_ATTESTATION=none
# PEM bundle of attestation roots; empty = record x5c attestation as unverified
PASSKEYD_TRUST_ANCHORS=
PASSKEYD_REQUIRE_TRUSTED=false
# Reject backup-eligible (synced) passkeys
PASSKEYD_DEVICE_BOUND=false
# reject | flag
PASSKEYD_CLONE_POLICY=reject
# Ceremony starts per minute per client IP (-1 disables)
PASSKEYD_RATE_LIMIT=30
# debug | info | warn | error ; text | json
PASSKEYD_LOG_LEVEL=info
PASSKEYD_LOG_FORMAT=text
